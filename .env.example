# JARVES local development defaults; no paid API key is needed for Ollama/auto.
HOST=0.0.0.0
PORT=3000
AI_PROVIDER=auto
AI_CONTEXT_TOKENS=16384
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000
DB_PATH=./data/jarves.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=536870912

# Optional remote OpenAI-compatible provider. It may incur usage charges.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
